# Copy this file to .env.local (picked up by Next.js).
# Foundry reads variables from the shell — export them or use a .env file with `source`.
# NEVER commit .env.local or any file containing real keys.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_MB=10

# ── Reviewer access (demo-grade) ──────────────────────────────────────────────
REVIEWER_PASSCODE=change-me-to-something-long
SESSION_SECRET=generate-a-random-32+char-string

# ── Supabase (server-side only; never expose the service role key) ────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_BUCKET=evidence

# ── LLM ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Sepolia / Foundry ─────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://YOUR-SEPOLIA-RPC-ENDPOINT
CHAIN_ID=11155111
EXPLORER_BASE_URL=https://sepolia.etherscan.io
# Use a NEW burner wallet with only test ETH.
DEPLOYER_PRIVATE_KEY=
# Wallet that signs anchor transactions (can be the same burner for the hackathon)
RECORDER_PRIVATE_KEY=
REGISTRY_ADDRESS=
ETHERSCAN_API_KEY=
