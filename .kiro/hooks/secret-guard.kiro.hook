{
  "enabled": true,
  "name": "Secret and client-boundary guard",
  "description": "After editing source files, check that secrets and server-only modules are not exposed to the browser.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src/**/*.ts", "src/**/*.tsx"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the file just edited. Flag and fix if: (1) it reads process.env directly instead of via src/lib/env.ts; (2) a file with 'use client' imports from src/lib/supabase, src/lib/chain/anchor, src/lib/llm or src/lib/env; (3) any key, passcode or service-role value is logged or returned in a response; (4) an API route returns a raw provider error. Reply only if something needs fixing."
  }
}
